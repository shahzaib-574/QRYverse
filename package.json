{
  "name": "qry-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-admob.mjs",
    "patch:admob": "node scripts/patch-admob.mjs",
    "test:admob-patch": "node scripts/patch-admob.mjs --check",
    "play:icon:srgb": "python scripts/tag-play-icon-srgb.py",
    "play:assets": "python scripts/prepare-play-screenshots.py",
    "play:assets:release": "python scripts/prepare-play-screenshots.py --release",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src scripts server",
    "test": "npm run test:admob-patch && tsx scripts/selfcheck.ts && tsx server/selfcheck.ts",
    "server:dev": "tsx watch server/index.ts",
    "server:start": "tsx server/index.ts",
    "server:typecheck": "tsc -p tsconfig.server.json",
    "server:build": "tsc -p tsconfig.server.build.json",
    "android:add": "npm run build && cap add android",
    "android:sync": "npm run patch:admob && npm run build && cap sync android",
    "android:debug": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:local-clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-local-build.ps1 clean",
    "android:local-verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-local-build.ps1 verifyDebug",
    "android:local-debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-local-build.ps1 assembleDebug",
    "android:local-lint": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-local-build.ps1 lintDebug",
    "android:local-test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-local-build.ps1 testDebugUnitTest",
    "android:local-instrumentation-apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-local-build.ps1 assembleDebugAndroidTest",
    "android:audit-debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-binary-audit.ps1 -ArtifactProfile Debug",
    "android:local-bundle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-local-build.ps1 bundleRelease",
    "android:bundle": "npm run android:sync && cd android && gradlew.bat bundleRelease"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@capacitor-community/admob": "8.1.0",
    "@capacitor-mlkit/barcode-scanning": "^8.0.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.3",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.1",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxlint": "^1.75.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
