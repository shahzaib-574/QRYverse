# Google Mobile Ads (AdMob). During development, leave the banner ID empty and
# keep test mode enabled to use Google's official Android demo banner.
# QRY_ADMOB_APP_ID is read by Gradle; these IDs are public app configuration,
# not secrets. A production release must use the IDs created for QRYverse.
QRY_ADMOB_APP_ID=ca-app-pub-3940256099942544~3347511713
VITE_ADMOB_BANNER_ID=
VITE_ADMOB_TEST_MODE=true
VITE_ADMOB_TEST_DEVICE_IDS=

# Keep empty for the v1 Play launch profile. Set localhost only for explicit
# development of the non-production cloud foundation.
VITE_QRY_CLOUD_API_URL=

# Server-only settings. Never expose these through a VITE_ variable.
QRY_HOST=127.0.0.1
QRY_PORT=8787
QRY_DATABASE_PATH=data/qryverse.sqlite
QRY_PUBLIC_BASE_URL=http://127.0.0.1:8787
QRY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
